rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── COLLECTOR UPLOADS (raw collected files) ──
    // Path: uploads/{projectId}/{collectorId}/{filename}
    match /uploads/{projectId}/{collectorId}/{filename} {
      allow read:  if request.auth != null &&
                      (request.auth.uid == collectorId ||
                       firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin']);
      allow write: if request.auth != null && request.auth.uid == collectorId
                      && request.resource.size < 100 * 1024 * 1024; // 100MB per file
    }

    // ── DATASETS (final approved files for clients) ──
    // Clients download via Cloud Function signed URLs only — direct access blocked
    match /datasets/{projectId}/{filename} {
      allow read:  if request.auth != null &&
                      firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow write: if request.auth != null &&
                      firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ── MSA PDFs ──
    match /contracts/{contractId}/{filename} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null &&
                      firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ── PROFILE AVATARS ──
    match /avatars/{uid}/{filename} {
      allow read:  if true;
      allow write: if request.auth != null && request.auth.uid == uid
                      && request.resource.contentType.matches('image/.*')
                      && request.resource.size < 2 * 1024 * 1024; // 2MB
    }
  }
}
